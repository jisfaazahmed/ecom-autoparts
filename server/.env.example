# MongoDB (required for server and seed)
MONGO_IP=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DB=ecom-autoparts

# Super Admin seed (required only for: npm run seed)
# Do not commit real credentials. Copy this file to .env and set your own values.
SUPER_ADMIN_EMAIL=your-admin@example.com
SUPER_ADMIN_PASSWORD=your-secure-password

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
USE_STRIPE_MOCK=true

# Development-only auth mock (do not enable in production)
USE_AUTH_MOCK=false
MOCK_AUTH_USER_ID=000000000000000000000001
MOCK_AUTH_ROLE=customer
MOCK_AUTH_EMAIL=mock-customer@example.com

# Client URL (for Stripe redirect URLs)
CLIENT_URL=http://localhost:3000
