# MongoDB (required for server and seed)
MONGO_IP=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DB=ecom-autoparts

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Super Admin seed (npm run seed only)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password

# App URLs
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=5000
NODE_ENV=development

# Email / SMTP (signup OTP, password reset, order emails)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your login password.
# Docker: keep EMAIL_FROM as a plain address (no angle brackets) to avoid env_file parse errors.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM_NAME=AutoMatrix
EMAIL_FROM_ADDRESS=your-email@gmail.com

# Optional SMTP_* aliases (same values as EMAIL_* — either set works)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password

# Stripe (optional for payments)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
