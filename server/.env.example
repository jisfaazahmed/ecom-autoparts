# Copy this file to .env and set your own values. Do not commit real credentials.

# MongoDB (required for server and seed)
# Use 127.0.0.1 rather than localhost on Windows: the mongo container publishes IPv4
# only, and "localhost" resolves to ::1 first, which times out instead of connecting.
MONGO_IP=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=password
MONGO_DB=ecom-autoparts

# Server (required)
PORT=5000
NODE_ENV=development

# Auth (required)
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Client URL (required)
# Used for Stripe redirects, password-reset links, and every link inside outgoing email.
# services/emails/EmailBuilder.js backfills FRONTEND_URL from this; without either, every
# link in every email renders as href="undefined".
CLIENT_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Stripe (required for card checkout)
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Super Admin seed (required only for: npm run seed)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password

# SMTP (required for real email delivery)
# These names are the complete contract - config/mail.js reads these and nothing else.
# There are deliberately no aliases: EMAIL_HOST / EMAIL_USER / SMTP_PASSWORD / SENDER_EMAIL
# and friends are NOT read, so a typo fails loudly instead of silently falling back.
# SMTP_SECURE is optional and defaults to true only on port 465.
# EMAIL_FROM is a full mailbox; a bare address gets "AutoMatrix" prepended.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=AutoMatrix <your-email@gmail.com>

# Admin alert recipient (optional)
# Extra address for admin_* notifications, on top of every SUPER_ADMIN user in the
# database. Falls back to SMTP_USER, then SUPER_ADMIN_EMAIL.
ADMIN_EMAIL=admin@example.com

# Gemini API Key (required for ask AI analytics assistant)
GEMINI_API_KEY=your-gemini-api-key
