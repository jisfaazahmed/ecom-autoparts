# Production image for the web client: Vite build served by nginx.
# The dev image (./Dockerfile) stays as-is for docker-compose.dev.yml, which runs the Vite dev server.

FROM node:22-alpine AS build
WORKDIR /app

# Vite inlines import.meta.env.VITE_* at BUILD time, so these must arrive as build
# args. Setting them as runtime env on the container has no effect -- the bundle is
# already compiled by then.
ARG VITE_API_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
